# Variáveis de ambiente - KairoPont
# Copie este arquivo como .env e preencha os valores

# Supabase - Credenciais públicas do projeto (seguras para o frontend)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# Não coloque SUPABASE_SERVICE_ROLE_KEY aqui: este arquivo alimenta o Vite.
# Scripts administrativos recebem a chave privilegiada diretamente pelo ambiente
# local seguro do terminal. Nunca a envie ao navegador, Git ou GitHub Actions.
